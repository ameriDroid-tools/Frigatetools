#!/usr/bin/env python3
"""Fake docker CLI for tests. Logs argv; runs `exec` commands locally."""
import json, os, subprocess, sys
log = os.environ["FAKE_DOCKER_LOG"]
with open(log, "a") as f:
    f.write(json.dumps(sys.argv[1:]) + "\n")
args = sys.argv[1:]
if args[0] == "inspect":
    print(json.dumps([{"State": {"Running": True}, "Mounts": [
        {"Type": "bind", "Source": os.environ["FAKE_CFG_DIR"], "Destination": "/config"}]}]))
    sys.exit(0)
if args[0] == "restart":
    print(args[-1]); sys.exit(0)
if args[0] == "exec":
    rest = args[1:]
    env = dict(os.environ)
    while rest and rest[0].startswith("-"):
        if rest[0] == "-e":
            rest = rest[2:]   # value inherited from our environment
        else:
            rest = rest[1:]
    container, cmd = rest[0], rest[1:]
    if os.environ.get("FAKE_NO_CONTAINER_FFPROBE") and "sh" == cmd[0] and "command -v ffprobe" in cmd[2]:
        sys.exit(0)
    env["PYTHONPATH"] = os.environ["FAKE_FRIGATE_PATH"]
    sys.exit(subprocess.run(cmd, env=env).returncode)
sys.exit(1)
