#!/usr/bin/env python3
import json, sys
from urllib.parse import urlsplit, unquote
if "-version" in sys.argv:
    print("ffprobe version 7.0.2-Jellyfin Copyright (c)"); sys.exit(0)
url = sys.argv[-1]
u = urlsplit(url)
key = (u.hostname, u.path)
V = lambda c, w, h, a=None: {"streams": [{"codec_type": "video", "codec_name": c, "width": w, "height": h}] + ([{"codec_type": "audio", "codec_name": a}] if a else [])}
table = {
    ("192.0.2.11", "/h265Preview_01_main"): V("hevc", 4512, 2512, "aac"),
    ("192.0.2.11", "/h264Preview_01_sub"): V("h264", 896, 512, "aac"),
    ("192.0.2.12", "/h264Preview_01_main"): V("h264", 7680, 2160, "aac"),
    ("192.0.2.12", "/h264Preview_01_sub"): V("h264", 1536, 432),
    ("192.0.2.13", "/h264Preview_01_main"): V("h264", 3840, 2160, "aac"),
    ("192.0.2.13", "/h264Preview_01_sub"): V("h264", 640, 360, "aac"),
    ("192.0.2.14", "/av_stream/ch0"): V("h264", 1920, 1080),
    ("192.0.2.14", "/av_stream/ch1"): V("h264", 640, 360),
    ("192.0.2.15", "/av_stream/ch0"): V("h264", 1920, 1080),
}
if key in table:
    print(json.dumps(table[key])); sys.exit(0)
# Simulate a chatty failure that leaks the URL and decoded password.
sys.stderr.write(f"[rtsp @ 0x55] method DESCRIBE failed: 404 Not Found\n{url}: Server returned 404 Not Found\n"
                 f"auth user={unquote(u.username or '')} pass={unquote(u.password or '')}\n")
sys.exit(1)
